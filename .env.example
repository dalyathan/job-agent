# Review loop
TARGET_SCORE=9          # a draft passes when a blind reviewer scores it >= this (1-10)
MAX_ITERATIONS=5        # rounds before giving up and sending a push notification

# Private data folder (resumes, profile, vector index, drafts, tracker). Never commit it.
JOB_AGENT_DATA=~/Documents/job-agent-data

# Retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=14

# Handshake intake: a saved search URL from your Handshake account (filters set the way you like)
HANDSHAKE_SEARCH_URL="https://app.joinhandshake.com/stu/postings?sort_direction=desc&sort_column=created_at"
HANDSHAKE_MAX_NEW_PER_RUN=15
MIN_FIT_SCORE=6         # skip postings the fit check scores below this (1-10)
